# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — or the legacy anon key also works here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Which event the public page shows (matches events.slug in the database)
NEXT_PUBLIC_EVENT_SLUG=leaders-training-2026
